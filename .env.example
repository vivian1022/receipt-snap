# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-...            # Your API key (OpenAI or any compatible gateway)
OPENAI_BASE_URL=                  # Optional: gateway base URL (e.g. https://api.ilmu-console.com/v1) — leave empty for OpenAI
OPENAI_MODEL=                     # Optional: model name — defaults to gpt-4o-mini
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ... # Service role / secret key (server-side only)
PORT=3000
